      "gridPos": {
        "x": 4,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up) / count(up)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
