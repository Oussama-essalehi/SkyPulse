      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (increase(skyradar_anomaly_alert_events_total{status=\"active\"}[1h]))",
