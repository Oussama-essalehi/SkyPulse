# =============================================================================
# SkyRadar configuration. Copy to .env (never commit .env) and adjust.
#   cp .env.example .env
# Every variable has a safe default: the stack runs with this file unchanged
# (anonymous OpenSky mode, assistant disabled).
# =============================================================================

# ---------------------------------------------------------------- data source
# opensky = live ADS-B data | replay = replay a recorded Parquet file (no quota used)
SOURCE=opensky

# OpenSky OAuth2 client credentials (https://opensky-network.org -> Account -> API client).
# Leave empty for anonymous mode (400 credits/day -> one global poll every 16 min).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Set to true if your account is an active feeder (8000 credits/day instead of 4000).
OPENSKY_FEEDER=false

# "auto" computes the shortest interval that keeps 24h usage under the daily quota:
#   anonymous 960 s | standard 96 s | feeder 48 s  (global request = 4 credits, 10% margin)
# A number is accepted but raised to the safe minimum if it would exceed the quota.
POLL_INTERVAL_SECONDS=auto
# Fraction of the daily quota kept in reserve.
OPENSKY_QUOTA_MARGIN=0.10
# Optional bounding box "lamin,lomin,lamax,lomax" (cheaper calls -> shorter interval),
# e.g. Europe: 35,-15,62,35
OPENSKY_BBOX=

# Replay mode (SOURCE=replay). Record a file with `make record`; when the file is
# missing a synthetic dataset is generated so the demo always works offline.
REPLAY_PATH=/data/replay/replay.parquet
REPLAY_SPEED=1
REPLAY_LOOP=true

# Aircraft card: departure / destination of a callsign from adsbdb (public, no key;
# the API sends it the callsign and icao24 of the clicked aircraft, results are cached).
# off = route only from SkyRadar's own history.
ROUTE_LOOKUP=adsbdb
# Requests per minute towards adsbdb, all clients together (aircraft cards, airport boards).
ADSBDB_BUDGET=300/minute
# Airport weather in the airport filter and board: latest METAR from aviationweather.gov
# (NOAA, public, no key; cached 10 min per airport). off = no weather.
WEATHER_LOOKUP=metar

# Upper-air winds (ETA feature) fetched once a day from Open-Meteo (free, no key,
# CC BY 4.0, non-commercial use). false = no outbound call besides OpenSky.
WEATHER_ENABLED=true

# Retention (daily lake_maintenance job + every dbt run), counted back from the newest
# data, never from the clock: raw state vectors kept in the lake (days, 0 = keep all)
# and positions kept in the warehouse (stg_aircraft_states, the long-term history).
LAKE_RETENTION_DAYS=30
WAREHOUSE_HISTORY_DAYS=180

# ------------------------------------------------------------ object storage
# S3-compatible storage (SeaweedFS locally; any S3 endpoint works).
S3_ACCESS_KEY=skyradar
S3_SECRET_KEY=change-me-s3-secret
S3_REGION=us-east-1
S3_BUCKET=skyradar-lake
# Parquet sink: seconds between two flushes to the lake.
SINK_FLUSH_INTERVAL_SECONDS=300

# ------------------------------------------------------- metadata (Postgres)
# Shared by Dagster, Superset and MLflow (one database each).
POSTGRES_USER=skyradar
POSTGRES_PASSWORD=change-me-postgres

# ------------------------------------------------------------------ Superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me-superset
# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me-superset-secret-key

# ---------------------------------------------------------------- monitoring
# Grafana (http://localhost:3002): dashboard "SkyRadar — Supervision" and alert rules.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
PROMETHEUS_RETENTION=15d

# ---------------------------------------------------------------- assistant
# Without a key the assistant is disabled cleanly (the rest of the stack works).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max (medium is plenty for text-to-SQL).
ASSISTANT_EFFORT=medium
# Alternative: a local model served by Ollama, e.g. http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# --------------------------------------------------------------------- misc
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
# json (containers) or console (human friendly)
LOG_FORMAT=json

# ------------------------------------------------------------- deployment
# Option A of docs/deployment.md (single VM behind Caddy): public domain name.
SKYRADAR_DOMAIN=
# "full" profile on the VM: Caddyfile.full also serves the admin tools on sub-domains
# (dagster., mlflow., superset., kafka., grafana.) behind a password.
SKYRADAR_CADDYFILE=Caddyfile
ADMIN_USER=admin
# bcrypt hash, between SINGLE quotes (it contains $):
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-password'
ADMIN_PASSWORD_HASH=''

# Rate limits of a public demo ("off" disables one). The budget caps the LLM bill.
API_RATE_ASSISTANT=5/minute,40/day
API_ASSISTANT_BUDGET=300/day
API_RATE_AIRCRAFT=60/minute
API_RATE_AIRPORT=20/minute
