# =============================================================================
# SkyRadar configuration. Copy to .env (never commit .env) and adjust.
#   cp .env.example .env
# Every variable has a safe default: the stack runs with this file unchanged
# (anonymous OpenSky mode, assistant disabled).
# =============================================================================

# ---------------------------------------------------------------- data source
# opensky = live ADS-B data | replay = replay a recorded Parquet file (no quota used)
SOURCE=opensky

# OpenSky OAuth2 client credentials (https://opensky-network.org -> Account -> API client).
# Leave empty for anonymous mode (400 credits/day -> one global poll every 16 min).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Set to true if your account is an active feeder (8000 credits/day instead of 4000).
OPENSKY_FEEDER=false

# "auto" computes the shortest interval that keeps 24h usage under the daily quota:
#   anonymous 960 s | standard 96 s | feeder 48 s  (global request = 4 credits, 10% margin)
# A number is accepted but raised to the safe minimum if it would exceed the quota.
POLL_INTERVAL_SECONDS=auto
# Fraction of the daily quota kept in reserve.
OPENSKY_QUOTA_MARGIN=0.10
# Optional bounding box "lamin,lomin,lamax,lomax" (cheaper calls -> shorter interval),
# e.g. Europe: 35,-15,62,35
OPENSKY_BBOX=

# Replay mode (SOURCE=replay). Record a file with `make record`; when the file is
# missing a synthetic dataset is generated so the demo always works offline.
REPLAY_PATH=/data/replay/replay.parquet
REPLAY_SPEED=1
REPLAY_LOOP=true

# ------------------------------------------------------------ object storage
# S3-compatible storage (SeaweedFS locally; any S3 endpoint works).
S3_ACCESS_KEY=skyradar
S3_SECRET_KEY=change-me-s3-secret
S3_REGION=us-east-1
S3_BUCKET=skyradar-lake
# Parquet sink: seconds between two flushes to the lake.
SINK_FLUSH_INTERVAL_SECONDS=300

# ------------------------------------------------------- metadata (Postgres)
# Shared by Dagster, Superset and MLflow (one database each).
POSTGRES_USER=skyradar
POSTGRES_PASSWORD=change-me-postgres

# ------------------------------------------------------------------ Superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me-superset
# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me-superset-secret-key

# ---------------------------------------------------------------- assistant
# Without a key the assistant is disabled cleanly (the rest of the stack works).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max (medium is plenty for text-to-SQL).
ASSISTANT_EFFORT=medium
# Alternative: a local model served by Ollama, e.g. http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# --------------------------------------------------------------------- misc
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
# json (containers) or console (human friendly)
LOG_FORMAT=json
