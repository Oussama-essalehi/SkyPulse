pipeline/dbt/target/
pipeline/dbt/dbt_packages/
pipeline/dbt/logs/
# Dagster
pipeline/dagster/.dagster_home/
# Node
node_modules/
frontend/dist/
# MLflow local runs
mlruns/
# OS / IDE
.DS_Store
.idea/
.vscode/
*.tsbuildinfo

# Playwright
frontend/playwright-report/
frontend/test-results/
